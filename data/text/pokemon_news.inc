
gPokeNewsTextSlateport_Upcoming::
	.string "Bonjour !\n"
	.string "Voici les INFOS POKéMON.\p"
	.string "La star locale de POIVRESSEL,\n"
	.string "l'ENERGY GURU, revient en une !\p"
	.string "Il promet de se donner à fond\n"
	.string "dans exactement {STR_VAR_1} jours !\p"
